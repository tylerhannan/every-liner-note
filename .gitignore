# Dumps, Parquet, and the ClickHouse stores (about 21 GB), all rebuilt by ./build.sh --dump
data/*
# ...except the AI step's output and the cover lookups, so a rebuild doesn't need Ollama or MusicBrainz
!data/ai/
!data/covers.tsv
data/ai/people_facts.jsonl

# Raw Discogs collection exports. The page data in web/data/ is what gets published.
*collection*.csv
*collection*.zip

# clickhousectl's saved Cloud login
.clickhouse/

# Private notes and tooling
notes/
private/

.DS_Store
__pycache__/
